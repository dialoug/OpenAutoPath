@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Qt6 6.11 COMPONENTS Core)
find_dependency(Threads)

# The dependency location belongs to the consuming machine. Never embed the
# producing checkout's external/ directory in the installed package.
if(NOT DEFINED OAP_OCCT_PROVIDER)
    set(OAP_OCCT_PROVIDER "@OAP_OCCT_PROVIDER@")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/OAPOCCT.cmake")
if(OAP_OCCT_PROVIDER STREQUAL "WINDOWS_SDK")
    if(NOT OAP_OCCT_ROOT)
        set(OAP_OCCT_ROOT "$ENV{OAP_OCCT_ROOT}")
    endif()
    if(NOT OAP_OCCT_ROOT)
        set(OpenAutoPath_FOUND FALSE)
        set(OpenAutoPath_NOT_FOUND_MESSAGE "Set OAP_OCCT_ROOT to the OCCT SDK, or use OAP_OCCT_PROVIDER=PACKAGE")
        return()
    endif()
    oap_load_occt_windows_sdk("${OAP_OCCT_ROOT}")
elseif(OAP_OCCT_PROVIDER STREQUAL "PACKAGE")
    oap_load_occt_package()
else()
    set(OpenAutoPath_FOUND FALSE)
    set(OpenAutoPath_NOT_FOUND_MESSAGE "Unknown OAP_OCCT_PROVIDER: ${OAP_OCCT_PROVIDER}")
    return()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/OpenAutoPathTargets.cmake")
check_required_components(OpenAutoPath)
