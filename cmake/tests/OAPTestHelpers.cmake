# Register an additional invocation of an existing executable without rebuilding it.
function(oap_add_smoke_test_case name target)
    cmake_parse_arguments(PARSE_ARGV 2 TEST "RUN_SERIAL"
        "TIMEOUT;SKIP_RETURN_CODE" "ARGS;LABELS;ENVIRONMENT")
    if(TEST_UNPARSED_ARGUMENTS OR TEST_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "Invalid test declaration for ${name}: ${ARGN}")
    endif()
    if(NOT TARGET ${target})
        message(FATAL_ERROR "Test ${name} refers to unknown target ${target}")
    endif()
    oap_add_test_with_runtime(${name} ${target} ${TEST_ARGS})
    foreach(property TIMEOUT SKIP_RETURN_CODE LABELS ENVIRONMENT)
        if(DEFINED TEST_${property})
            set_tests_properties(${name} PROPERTIES
                ${property} "${TEST_${property}}")
        endif()
    endforeach()
    if(TEST_RUN_SERIAL)
        set_tests_properties(${name} PROPERTIES RUN_SERIAL TRUE)
    endif()
endfunction()

# Keep sources, dependencies and CTest policy together at the call site.
function(oap_add_smoke_test name)
    cmake_parse_arguments(PARSE_ARGV 1 TEST "AUTOMOC;OCCT_VIEWER;RUN_SERIAL"
        "TIMEOUT;SKIP_RETURN_CODE" "SOURCES;LIBRARIES;ARGS;LABELS;ENVIRONMENT")
    # Parse executable settings separately; forward CTest settings explicitly.
    if(TEST_UNPARSED_ARGUMENTS OR TEST_KEYWORDS_MISSING_VALUES OR
       NOT TEST_SOURCES OR NOT TEST_LIBRARIES)
        message(FATAL_ERROR "Invalid executable declaration for ${name}: ${ARGN}")
    endif()
    set(target oap_test_${name})
    add_executable(${target} ${TEST_SOURCES})
    target_link_libraries(${target} PRIVATE ${TEST_LIBRARIES})
    if(TEST_AUTOMOC)
        set_target_properties(${target} PROPERTIES AUTOMOC ON)
    endif()
    if(TEST_OCCT_VIEWER)
        oap_configure_occt_viewer_target(${target} PRIVATE)
    endif()
    oap_configure_fast_test(${target})
    set(test_options)
    foreach(property ARGS LABELS ENVIRONMENT TIMEOUT SKIP_RETURN_CODE)
        if(DEFINED TEST_${property})
            list(APPEND test_options ${property} ${TEST_${property}})
        endif()
    endforeach()
    if(TEST_RUN_SERIAL)
        list(APPEND test_options RUN_SERIAL)
    endif()
    oap_add_smoke_test_case(${name} ${target} ${test_options})
endfunction()
